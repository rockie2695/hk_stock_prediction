# ============================================
# 港股預測系統 - 環境變數設定
# ============================================
# 複製此檔案為 .env，然後填入你的 Supabase 專案資訊
# ============================================

# Supabase 專案 URL (Project URL，不是 PostgreSQL 連線字串)
# 格式: https://xxxxxxxxxxxx.supabase.co
# 在 Supabase Dashboard > Settings > Project URL 取得
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon public 金鑰
# 在 Supabase Dashboard > Settings > API > anon public 取得
SUPABASE_KEY=your-anon-key

# 要預測的港股代碼 (逗號分隔)
STOCK_LIST=0700,9988,0005,0939

# ============================================
# 模型訓練開關
# ============================================
# 啟用模型集成 (VotingClassifier / StackingClassifier)
# True: 使用 XGBoost + LightGBM + RandomForest 集成
# False: 使用單一模型 (XGBoost vs LightGBM 選一)
USE_ENSEMBLE=True

# 使用 StackingClassifier (需要 USE_ENSEMBLE=True)
# True: 使用 Stacking (元模型 = LogisticRegression)
# False: 使用 VotingClassifier (soft voting)
USE_STACKING=False

# 啟用 SMOTE 類別不平衡處理
# True: 在訓練折上使用 SMOTE 擴充少數類樣本
# False: 不使用 SMOTE (依賴 scale_pos_weight)
USE_SMOTE=True
