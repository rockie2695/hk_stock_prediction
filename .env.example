# ============================================
# 港股預測系統 - 環境變數設定
# ============================================
# 複製此檔案為 .env，然後填入你的 Supabase 專案資訊
# ============================================

# Supabase 專案 URL (Project URL，不是 PostgreSQL 連線字串)
# 格式: https://xxxxxxxxxxxx.supabase.co
# 在 Supabase Dashboard > Settings > Project URL 取得
SUPABASE_URL=https://yfmotpwhfpioczfurfvw.supabase.co

# Supabase anon public 金鑰
# 在 Supabase Dashboard > Settings > API > anon public 取得
SUPABASE_KEY=sb_publishable_...

# 要預測的港股代碼 (逗號分隔)
STOCK_LIST=0700,9988,0005,0939
