# ============================================
# 港股預測系統 - 環境變數設定
# ============================================
# 複製此檔案為 .env，然後填入你的 Supabase 專案資訊
# ============================================

# Supabase 專案 URL (Project URL，不是 PostgreSQL 連線字串)
# 格式: https://xxxxxxxxxxxx.supabase.co
# 在 Supabase Dashboard > Settings > Project URL 取得
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon public 金鑰
# 在 Supabase Dashboard > Settings > API > anon public 取得
SUPABASE_KEY=your-anon-key

# 要預測的港股代碼 (逗號分隔)
STOCK_LIST=0700,9988,0005,0939

# ============================================
# 模型訓練開關
# ============================================

# 啟用模型集成 (預設: True)
# True: 使用模型集成 (Voting/Stacking/Blending)
# False: 使用單一最佳模型 (XGBoost vs LightGBM vs CatBoost)
USE_ENSEMBLE=True

# 使用 StackingClassifier (預設: False)
# True: 使用 Stacking (元模型學習組合)，自動強制啟用集成
# False: 不使用 Stacking
USE_STACKING=False

# 使用 Blending 集成 (預設: False)
# True: 使用 Blending (out-of-fold stacking)，通常最準確但最慢
# False: 不使用 Blending
USE_BLENDING=False

# 包含 CatBoost 模型 (預設: True)
# True: 加入 CatBoost 作為第4個模型 (通常在金融數據上表現更好)
# False: 只使用 XGBoost + LightGBM + RandomForest
USE_CATBOOST=True

# 使用 GPU 訓練 CatBoost (預設: False)
# True: 使用 GPU 加速 CatBoost 訓練 (需要 NVIDIA GPU，會使用更多記憶體)
# False: 使用 CPU 訓練 (較少記憶體使用)
USE_GPU=False

# 啟用 SMOTE 類別不平衡處理 (預設: True)
# True: 在訓練折上使用 SMOTE 擴充少數類樣本
# False: 不使用 SMOTE (依賴 scale_pos_weight)
USE_SMOTE=True

# ============================================
# 訓練模式說明
# ============================================
# 優先級規則:
#   USE_STACKING=True 或 USE_BLENDING=True → 強制使用集成模式
#   USE_ENSEMBLE=True (預設) → VotingClassifier (加權平均，最快)
#   USE_ENSEMBLE=False → 單一最佳模型
#
# 模型比較:
#   Voting:   加權平均四個模型，速度最快 (預設)
#   Stacking: 元模型學習組合，較慢但通常更準
#   Blending: out-of-fold stacking，最慢但通常最準
#
# 速度:
#   平行訓練: 時間範圍 (1d, 5d, 20d) 同時訓練，速度提升 ~3x
#   平行預測: 多支股票同時預測
#
# 模型分歧:
#   當四個模型 (XGBoost, LightGBM, RandomForest, CatBoost) 意見分歧 >= 50%
#   系統會自動將信號設為 Hold，避免在不確定時刻進場。
#   例如: 2 Buy vs 2 Sell → 強制 Hold
#   儀表板會顯示分歧程度 (如 ⚠️ 分歧: 2/2)
#
# GPU 訓練:
#   USE_GPU=False (預設): 使用 CPU 訓練 CatBoost (較少記憶體使用)
#   USE_GPU=True: 使用 NVIDIA GPU 加速 CatBoost 訓練 (需要 nvidia-smi)
#   注意: GPU 訓練會使用更多記憶體，如果記憶體不足請使用 CPU
# ============================================

# ============================================
# 測試
# ============================================
# 執行所有測試:
#   python -m pytest tests/ -v
#
# 執行特定測試:
#   python -m pytest tests/test_config.py -v
#   python -m pytest tests/test_feature_engineering.py -v
#   python -m pytest tests/test_train_model.py -v
#   python -m pytest tests/test_predict.py -v
#
# 測試覆蓋: 49 個測試，涵蓋設定、特徵工程、模型訓練、預測功能
# ============================================
